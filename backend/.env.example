# Server
PORT=4600
NODE_ENV=development

# Signing secret for dashboard sessions + webhook HMAC.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# Where the ledger is stored. Leave unset locally (defaults to backend/.data).
# In production point this at a mounted persistent disk — Render uses /var/data.
# DATA_DIR=/var/data

# Comma-separated browser origins allowed to call the API.
# Leave unset locally and any origin is reflected, so the dev server just works.
# In production set it to your deployed frontend, e.g. https://your-app.vercel.app
WEB_ORIGIN=

# Load the demo dataset automatically the first time the API boots against an
# empty database. Meant for hosts with no shell access, where `npm run seed`
# is not available. It only ever runs when there are zero users, so it cannot
# overwrite real data no matter how often the service restarts.
SEED_ON_EMPTY=

# Optional — AI dispute triage. Without a key SafePay falls back to a
# deterministic rule-based classifier, so the flow always works.
GEMINI_API_KEY=

# Fees
PLATFORM_FEE_BPS=150          # 1.50% of escrow amount
RESERVE_SHARE_BPS=2000        # 20% of collected fees feed the Buyer Protection Reserve

# ---------------------------------------------------------------------------
# Firebase Admin  (Authentication + Firestore)
# ---------------------------------------------------------------------------
# Leave every value below empty and the API runs entirely on its local JSON
# store: no credentials needed to clone and run. Set them and Firestore becomes
# the durable source of truth and every account gets a Firebase Auth record.
#
# Easiest form -- the whole service-account JSON on one line. Base64 is strongly
# preferred over raw JSON in a hosting dashboard, because nothing downstream can
# then mangle the private key's newlines:
#
#   node -e "console.log(Buffer.from(require('fs').readFileSync('serviceAccountKey.json','utf8')).toString('base64'))"
#
FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above, for hosts that dislike very long values. Supply all
# three. Keep the private key's \n escapes exactly as they appear in the JSON.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Keplars  (transactional email)
# ---------------------------------------------------------------------------
# Without a key the mailer runs in console mode: verification codes are printed
# to the server log instead of sent, so a credential-less clone can still get
# through the signup gate. Never ship a production deploy that way -- the log
# then contains live codes.
#
# Get one from the Keplars dashboard -> API Keys. It is the "live" kind:
#   kms_<workspaceId>.live_<secret>
KEPLARS_API_KEY=

# Optional sender override. Left empty, Keplars sends as the mailbox connected
# to your workspace (Gmail / Workspace / Outlook over OAuth, or a verified
# domain), which is what you want until you have more than one to choose from.
# An address Keplars does not recognise is rejected, not substituted.
# The "Name <addr>" form is accepted; only the address inside is sent.
MAIL_FROM=

# Optional. Where replies to those emails should go.
MAIL_REPLY_TO=

# Public URL of the frontend, used for the buttons inside emails. Falls back to
# the first entry in WEB_ORIGIN when unset.
APP_URL=
