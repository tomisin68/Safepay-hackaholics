# SafePay web — environment
#
# Copy to .env for local overrides. Vite only exposes VITE_-prefixed variables
# to the browser, and every value here ends up in the shipped bundle. Nothing
# secret belongs in this file.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Where the SafePay API lives, with no trailing slash:
#   VITE_API_URL=https://safepay-api.onrender.com
#
# Leave it EMPTY for local development — vite.config.js proxies /v1 and /health
# to http://localhost:4600, so the dev server talks to `npm --prefix backend run dev`.
#
# In a PRODUCTION build, leaving it empty switches the app into demo mode
# (below), because a static host has no API to answer /v1.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Serves the whole app from a seeded database in the visitor's own browser:
# the demo accounts sign in, escrows fund and release, SafeScore recomputes.
# Nothing is sent anywhere.
#
#   (unset)  auto — on for a production build with no VITE_API_URL, off otherwise
#   true     always on, even in dev and even if VITE_API_URL is set
#   false    always off
#
# Set this to false once a real API is deployed, so an outage surfaces as an
# error instead of silently serving fake data.
VITE_DEMO_MODE=

# ---------------------------------------------------------------------------
# Firebase (project safepay-6227f)
# ---------------------------------------------------------------------------
# These are public identifiers, not credentials — Firebase ships them in every
# client bundle and enforces access through Security Rules. They are variables
# only so a fork can point at its own project. src/lib/firebase.js falls back to
# the safepay-6227f values when they are unset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Leave empty to disable Analytics entirely.
VITE_FIREBASE_MEASUREMENT_ID=
